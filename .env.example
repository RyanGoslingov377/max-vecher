# Скопируй этот файл в .env и при необходимости поменяй значения.
# .env лежит только у тебя на компьютере и в git не попадает.
# На хостинге (Amvera) эти же переменные заданы в интерфейсе проекта.

# 0 — только сайт мини-приложения и API (так запускаем локально и для проверки),
# 1 — ещё и бот. Бот с одним токеном должен работать в одном месте: сейчас это хостинг.
BOT_ENABLED=0

# Токен бота — нужен только при BOT_ENABLED=1. Передаётся лично, в чаты и git не вставлять.
MAX_BOT_TOKEN=

# 1 — пускать запросы без подписи МАКС от тестового пользователя. Только для локальной проверки!
DEV_AUTH=0

# Для DEV_AUTH=1: id чата, куда слать тестовые приглашения (виден в логах бота). Можно оставить пустым.
DEV_CHAT_ID=

# «Сходили?»: пусто — в полдень следующего дня после события; число — через столько минут (демо)
FOLLOWUP_DELAY_MIN=

# HTTPS-адрес мини-приложения (для справки)
PUBLIC_URL=

PORT=3000
