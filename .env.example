# Скопируй этот файл в .env и впиши значения.
# .env лежит только у тебя на компьютере и в git не попадает.

# Токен бота. Нужен только там, где запущен бот (на хостинге он задан в переменных Amvera).
MAX_BOT_TOKEN=

# 1 — запускать бота вместе с сервером (хостинг, docker compose),
# 0 — только API и мини-приложение. Для локальной разработки ставим 0.
BOT_ENABLED=1

# 1 — пускать запросы без подписи МАКС от тестового пользователя. Только локально!
# Заработает после задачи Б4.
DEV_AUTH=0

# HTTPS-адрес мини-приложения (понадобится позже)
PUBLIC_URL=

PORT=3000
